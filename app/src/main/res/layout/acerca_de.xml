<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F9FF"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- ESPACIO ANTES DEL TÍTULO -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"/>  <!-- Ajusta la altura según necesites -->

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acerca de Nosotros"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FF6F00"
            android:paddingBottom="12dp"/>

        <!-- INFO DE LA APLICACIÓN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFO. DE LA APLICACIÓN"
                    android:textStyle="bold"
                    android:textColor="#45754D"
                    android:textSize="16sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WITZI"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#000"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Versión 2.0"
                    android:textSize="14sp"
                    android:textColor="#555"/>

                <ImageView
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="Logo"
                    android:src="@drawable/owo" />

                <TextView
                    android:layout_width="210dp"
                    android:layout_height="wrap_content"
                    android:text="Impulsando la equidad, el comercio y el orgullo cultural"
                    android:textSize="12sp"
                    android:textColor="#555"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="© 2024 - 2025"
                    android:textSize="12sp"
                    android:textColor="#666"
                    android:paddingTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- DESARROLLADORES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESARROLLADORES DEL PROYECTO"
                    android:textStyle="bold"
                    android:textColor="#45754D"
                    android:textSize="16sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👨‍💻 Programadores: Santiago Yamil González Juárez, Jürgen Jared Jiménez Vázquez, Alejandro Martines Solis"
                    android:textSize="14sp"
                    android:textColor="#000"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎨 Diseñadores gráficos: Santiago Yamil González Juárez, Jürgen Jared Jiménez Vázquez, Alejandro Martines Solis"
                    android:textSize="14sp"
                    android:textColor="#000"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔎 Investigadores: Dra. Angélica Mara Bello Ramírez, Alejandro Ruíz Barradas, Joselyn Gómez Cortés"
                    android:textSize="14sp"
                    android:textColor="#000"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📌 Gestor del proyecto: Equipo πzzas"
                    android:textColor="#000"
                    android:textSize="14sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- UNIDAD ACADÉMICA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UNIDAD ACADÉMICA"
                    android:textStyle="bold"
                    android:textColor="#45754D"
                    android:textSize="16sp"
                    android:paddingBottom="8dp"/>

                <ImageView
                    android:layout_width="320dp"
                    android:layout_height="180dp"
                    android:contentDescription="Logo Universidad"
                    android:src="@drawable/ic_universidad" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TecNM - Campus Orizaba, Ver."
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333"
                    android:paddingTop="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ASESORES -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ASESORES DEL PROYECTO"
                    android:textStyle="bold"
                    android:textColor="#45754D"
                    android:textSize="16sp"
                    android:paddingBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Dra Angélica Mara Bello Ramírez"
                    android:textColor="#000"
                    android:textSize="14sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
