<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Ambas centradas, pero desplazadas en X para quedar lado a lado -->
    <ImageView
        android:id="@+id/logoPrincipal"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        android:translationX="-70dp"
        android:src="@drawable/ic_logo_primary"
        android:contentDescription="Logo principal" />

    <ImageView
        android:id="@+id/logoSecundario"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_centerInParent="true"
        android:translationX="70dp"
        android:src="@drawable/ic_logo_secondary"
        android:contentDescription="Logo secundario" />

</RelativeLayout>


