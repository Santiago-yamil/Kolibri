<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 📌 CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Cabecera -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:background="@color/orange"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:gravity="center_vertical">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:layout_weight="0" />

            <ImageButton
                android:id="@+id/iconoSuperiorDerecha"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/book"
                android:contentDescription="Icono menú"
                android:padding="6dp"
                android:background="@drawable/fondeo_redondeado_dos"/>
        </LinearLayout>

        <!-- Contenido nunuu-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/gray"
            android:gravity="center_horizontal">

            <Spinner
                android:id="@+id/spinnerIdiomaOrigen"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/spiner_redondeado"/>

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/borde_edittext"
                android:hint="✏️ "
                android:textColor="@android:color/black"/>

            <Button
                android:id="@+id/botonGrabar"
                android:layout_marginTop="16dp"
                android:layout_width="165dp"
                android:layout_height="165dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/fondo_circular"
                android:backgroundTint="@null"
                android:contentDescription="Botón grabar"
                android:drawableTop="@drawable/micro"
                android:gravity="center"
                android:text=""
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/boton"
                android:layout_margin="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Traducir"
                android:background="@color/green"/>

            <Spinner
                android:id="@+id/spinnerIdiomaDestino"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/spiner_redondeado"/>

            <TextView
                android:id="@+id/textoTraduccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxHeight="150dp"
                android:padding="16dp"
                android:text="Aquí aparecerá la traducción"
                android:textColor="@android:color/black"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 📌 MENÚ LATERAL -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@android:color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menú"
            android:textSize="18sp"
            android:padding="16dp"/>

        <Button
            android:id="@+id/btnSaludos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saludos"/>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
