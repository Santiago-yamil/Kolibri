<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/dialog_background"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/dialogImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/dialogEs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Texto ES"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical|right"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/traduccion"
            android:layout_width="33dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|left"
            android:text="Traduccion:"
            android:layout_gravity="right"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/dialogTraduccion"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Traducción"
            android:layout_gravity="center"
            android:gravity="center_vertical|left"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/dialogIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="right"
            android:layout_gravity="right"
            android:src="@drawable/microfono"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/descipcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="left"
        android:textStyle="bold"
        android:text="Descipcion:"
        android:textColor="@color/black"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/dialogDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Texto de descripción largo"
        android:textSize="14sp"
        android:textColor="@color/black" />

</LinearLayout>
