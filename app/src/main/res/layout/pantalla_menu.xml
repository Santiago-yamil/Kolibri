<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray"
    android:orientation="vertical"
    tools:context=".SegundoActivity">

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:background="@color/orange"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <!-- Botón de libro (izquierda) -->
        <ImageButton
            android:id="@+id/iconoSuperiorDerecha"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/book"
            android:contentDescription="Icono libro"
            android:padding="6dp"
            android:background="@drawable/fondeo_redondeado_dos" />

        <!-- Espaciador flexible para empujar el siguiente a la derecha -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- GridLayout con 1 columna y 7 botones -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:columnCount="1"
        android:rowCount="7"
        android:padding="16dp">

        <!-- Botón 1 -->
        <Button
            android:id="@+id/btnSaludos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button_azul"
            android:padding="20dp"
            android:text="Saludos"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />

        <!-- Botón 2 -->
        <Button
            android:id="@+id/btnNumeros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button_verde"
            android:padding="20dp"
            android:text="Numeros"
            android:backgroundTint="@null"
            app:backgroundTint="@null" />

        <!-- Botón 3 -->
        <Button
            android:id="@+id/btnAlfabeto"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button_morado"
            android:padding="20dp"
            android:text="Alfabeto"
            app:backgroundTint="@null"/>

        <!-- Botón 4 -->
        <Button
            android:id="@+id/btnFamilia"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button_naranja"
            android:padding="20dp"
            android:text="Familia"
            app:backgroundTint="@null"/>

        <!-- Botón 5 -->
        <Button
            android:id="@+id/btnComercio"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button_rojo"
            android:padding="20dp"
            android:text="Comercio"
            app:backgroundTint="@null"/>

        <!-- Botón 6 -->
        <Button
            android:id="@+id/btnAnimales"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:background="@drawable/rounded_button_verde"
            android:padding="20dp"
            android:text="Animales"
            app:backgroundTint="@null"/>

        <!-- Botón 7 -->
        <Button
            android:id="@+id/btnCostumbres"
            android:backgroundTint="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_button_morado"
            android:padding="20dp"
            android:text="Colores"
            app:backgroundTint="@null"/>
    </GridLayout>
</LinearLayout>